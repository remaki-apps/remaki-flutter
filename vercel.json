{
  "buildCommand": "chmod +x build.sh && bash build.sh",
  "outputDirectory": "build/web",
  "installCommand": "echo 'skipping npm install'",
  "framework": null,
  "rewrites": [
    { "source": "/manifest.json", "destination": "/manifest.json" },
    { "source": "/favicon.png", "destination": "/favicon.png" },
    { "source": "/version.json", "destination": "/version.json" },
    { "source": "/((?!assets/|icons/).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate, max-age=0" },
        { "key": "Pragma", "value": "no-cache" },
        { "key": "Expires", "value": "0" }
      ]
    },
    {
      "source": "/assets/(.*\\.(png|jpg|jpeg|svg|gif|webp|woff|woff2|ttf|otf))",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400" }
      ]
    }
  ]
}
